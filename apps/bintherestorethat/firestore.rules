rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to all documents.
    // This enables QR codes to be scanned and viewed by anyone without authentication.
    match /{document=**} {
      allow read: if true;
    }

    // For now, allow writes for everyone as well, as per previous setup.
    // This can be secured later to only allow authenticated users.
    match /{document=**} {
      allow write: if true;
    }
  }
}
